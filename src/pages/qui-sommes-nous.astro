---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PersonCard from "../components/PersonCard.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { Image } from "astro:assets";
import estelle from "../assets/images/estelle.jpg";
import helene from "../assets/images/helene.jpg";
import nicolas from "../assets/images/nicolas.jpg";
---

<BaseLayout
  title="Qui sommes-nous"
  description="Découvrez l'équipe de l'Association Estelle & Thomas, engagée contre le harcèlement scolaire."
>
  <PageHero
    title="Qui sommes-nous"
    subtitle="Une équipe engagée contre le harcèlement scolaire"
  />

  <!-- Presidency -->
  <section class="bg-background py-24">
    <div class="max-w-[1200px] mx-auto px-5">
      <div class="flex flex-col lg:flex-row items-center gap-12 reveal">
        <Image
          src={estelle}
          alt="Estelle Masson, présidente de l'association"
          width={512}
          height={512}
          class="w-64 h-64 rounded-card object-cover shrink-0"
        />
        <div>
          <h2 class="font-display font-black text-3xl text-primary mb-2">
            Estelle Masson
          </h2>
          <p class="text-accent font-display font-semibold mb-6">
            Présidente de l'association
          </p>
          <p class="text-text leading-relaxed mb-4">
            Je suis Estelle, jeune femme dynamique et positive. J'ai été
            harcelée pendant 15 ans à cause de mon poids et mon style
            vestimentaire.
          </p>
          <p class="text-text leading-relaxed">
            D'abord victime, j'ai décidé de mettre mon expérience passée avec
            laquelle je suis en paix au service des autres. J'ai depuis toujours
            voulu faire de cet épisode difficile un moyen d'aider d'autres
            personnes.
          </p>
          <p class="text-text leading-relaxed mt-4">
            Assez parlé de moi, l'association Estelle et Thomas c'est aussi 3
            bénévoles...
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Volunteers -->
  <section class="bg-card py-24">
    <div class="max-w-[1200px] mx-auto px-5">
      <SectionHeading
        title="Nos Bénévoles"
        subtitle="Des personnes engagées qui donnent de leur temps pour faire la différence."
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 stagger-children">
        <PersonCard
          name="Hélène"
          role="Maman bénévole"
          description="Maman de deux ados, dont l'une a vécu le harcèlement scolaire, investie et volontaire dans la lutte contre ce fléau."
          image={helene}
        />
        <PersonCard
          name="Nicolas"
          role="Trésorier et secrétaire"
          description="Couteau suisse de la gestion, chef d'entreprises, bâtisseur, fédérateur, orateur, auteur, explorateur et secrétaire trésorier de l'association. Avec lui, vos dons seront bien distribués."
          image={nicolas}
        />
        <PersonCard
          name="Laure"
          role="Vice-présidente et graphiste"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<ScrollReveal />
