---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
---

<BaseLayout title="Contact" description="Contactez l'Association Estelle & Thomas pour toute question sur le harcèlement scolaire.">
  <PageHero
    title="Contactez-nous"
    subtitle="Une question, un témoignage, une envie de nous rejoindre ?"
  />

  <!-- Tally embed script — loaded in <head> via the layout slot -->
  <script is:inline slot="head" async src="https://tally.so/widgets/embed.js"></script>

  <section class="bg-background pt-8 pb-24">
    <div class="max-w-[700px] mx-auto px-5 reveal">
      <iframe
        data-tally-src="https://tally.so/embed/lbo4qB?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
        loading="lazy"
        width="100%"
        height="760"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title="Formulaire de contact"
      ></iframe>
      <noscript>
        <p class="text-center text-text">
          Écrivez-nous à
          <a href="mailto:contact.assoestelleetthomas@gmail.com" class="text-accent font-semibold">contact.assoestelleetthomas@gmail.com</a>
        </p>
      </noscript>
    </div>
  </section>

  <script is:inline>
    // Load Tally embeds once the widget script is ready (fallback: set src directly)
    (function () {
      var load = function () {
        if (typeof Tally !== "undefined") Tally.loadEmbeds();
        else document.querySelectorAll("iframe[data-tally-src]:not([src])").forEach(function (e) { e.src = e.dataset.tallySrc; });
      };
      if (document.readyState === "complete") load(); else window.addEventListener("load", load);
    })();
  </script>
</BaseLayout>

<ScrollReveal />
